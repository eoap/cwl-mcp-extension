{
  "@context": {
    "mcp": "https://eoap.github.io/cwl-mcp-extension#",
    "Tool": "mcp:Tool",
    "ToolAnnotations": "mcp:ToolAnnotations",
    "name": "mcp:name",
    "title": "mcp:title",
    "description": "mcp:description",
    "aliases": "mcp:aliases",
    "useWhen": "mcp:useWhen",
    "doNotUseWhen": "mcp:doNotUseWhen",
    "annotations": "mcp:annotations",
    "readOnlyHint": "mcp:readOnlyHint",
    "destructiveHint": "mcp:destructiveHint",
    "idempotentHint": "mcp:idempotentHint",
    "openWorldHint": "mcp:openWorldHint"
  }
}
