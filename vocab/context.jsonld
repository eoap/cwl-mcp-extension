{
  "@context": {
    "cwlmcp": "https://eoap.github.io/cwl-mcp-extension#",
    "Tool": "cwlmcp:Tool",
    "ToolAnnotations": "cwlmcp:ToolAnnotations",
    "name": "cwlmcp:name",
    "title": "cwlmcp:title",
    "description": "cwlmcp:description",
    "aliases": "cwlmcp:aliases",
    "useWhen": "cwlmcp:useWhen",
    "doNotUseWhen": "cwlmcp:doNotUseWhen",
    "annotations": "cwlmcp:annotations",
    "readOnlyHint": "cwlmcp:readOnlyHint",
    "destructiveHint": "cwlmcp:destructiveHint",
    "idempotentHint": "cwlmcp:idempotentHint",
    "openWorldHint": "cwlmcp:openWorldHint"
  }
}
